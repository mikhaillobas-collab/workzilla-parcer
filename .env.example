# ==========================================================
# ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ
# ==========================================================

# Ключ Gemini API (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy...

# Telegram Bot (для согласования откликов с кнопками "Откликнуться" / "Отклонить")
# Токен бота из @BotFather:
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
# Ваш числовой Telegram ID (отправьте боту команду /start, и он покажет ваш ID):
TELEGRAM_CHAT_ID=123456789
# Таймаут на решение по заказу в минутах (по умолчанию 15)
ORDER_TIMEOUT_MINUTES=15

# Удаленная база данных PostgreSQL (из раздела "Базы данных" в BotHost)
# Формат: postgresql://пользователь:пароль@хост:порт/имя_базы
# Если оставить пустым, бот автоматически использует локальный SQLite (data/workzilla.db)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Прокси для запросов к Google Gemini (HTTP или SOCKS5)
# Обязателен, если сервер или страна заблокированы для Gemini (для Германии не нужен)
PROXY_URL=

# ==========================================================
# НАСТРОЙКИ ДЛЯ ХОСТИНГА (BotHost / VPS / Docker)
# ==========================================================

# Режим браузера для сервера:
# "persistent" - запускает Chromium прямо на сервере
# "cdp" - подключение к Chrome через remote debugging port (для локального ПК)
BROWSER_MODE=persistent

# Фоновый режим браузера (без графического интерфейса)
# На серверах (Linux / BotHost) обязательно true!
HEADLESS=true

# Авторизационные куки Work-zilla для работы без ручного входа
# Можно вставить в формате заголовка Cookie ("auth=xyz; session=abc") или JSON
WORKZILLA_COOKIES=

# Безопасный режим (dry-run):
# true  - только оценивает и логирует отклики, НЕ отправляет ставки на бирже
# false - боевой режим (отправляет отклики заказчикам)
DRY_RUN=true

# ==========================================================
# ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ ФИЛЬТРОВ (ОПЦИОНАЛЬНО)
# ==========================================================
# Минимальная цена заказа в рублях (по умолчанию 150)
MIN_PRICE=150

# Максимальная длина отклика в символах (по умолчанию 320)
MAX_PROPOSAL_CHARS=320
