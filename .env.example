# Gemini API Key (получите в Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Proxy для обхода региональных блокировок Google API
# Формат: http://user:pass@host:port или socks5://user:pass@host:port
PROXY_URL=http://127.0.0.1:10809

# Режим работы браузера:
# "cdp" - подключение к уже открытому вами Chrome (рекомендуется для обхода капч и Cloudflare)
# "persistent" - запуск автономного профиля Playwright
BROWSER_MODE=cdp

# URL отладки Chrome (если BROWSER_MODE=cdp)
CDP_URL=http://127.0.0.1:9222

# Безопасный режим (dry-run):
# true - оценивает заказы, логирует отклики, но НЕ нажимает "Откликнуться" на сайте
# false - отправляет реальные отклики заказчикам
DRY_RUN=true
